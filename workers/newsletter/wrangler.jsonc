{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bailai-newsletter",
  "main": "src/index.js",
  "compatibility_date": "2026-07-10",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "www.790427.xyz/api/subscribe*",
      "zone_name": "790427.xyz"
    },
    {
      "pattern": "www.790427.xyz/api/newsletter*",
      "zone_name": "790427.xyz"
    },
    {
      "pattern": "www.790427.xyz/api/ops*",
      "zone_name": "790427.xyz"
    }
  ],
  "vars": {
    "SITE_URL": "https://www.790427.xyz",
    "SITE_NAME": "人到中年",
    "MAIL_FROM": "人到中年 <service@790427.xyz>",
    "REQUIRE_TURNSTILE": "true",
    "NEWSLETTER_BATCH_LIMIT": "50"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bailai_newsletter",
      "database_id": "3e62e94a-af0f-46ce-ad25-65c845a35553"
    },
    {
      "binding": "OPS_DB",
      "database_name": "daily_operations_metrics",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ],
  "observability": {
    "enabled": true
  }
}
